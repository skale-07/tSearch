# GitHub API token (optional if `gh auth login` is done)
# GITHUB_TOKEN=ghp_your_token_here

# Assessment / LLM (Phase 1–2)
# LLM_PROVIDER=openai          # openai | anthropic
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_API_KEY=sk-...           # fallback for the selected provider
# LLM_MODEL=gpt-4o-mini        # or e.g. claude-sonnet-4-5 when LLM_PROVIDER=anthropic
# ASSESSMENT_MOCK_LLM=1
# ASSESSMENT_FORCE_REFRESH=1
# ASSESSMENT_CANDIDATE_LIMIT=10
# ASSESSMENT_REPOSITORY_LIMIT=3
# ASSESSMENT_PUBLICATION_LIMIT=3
# ASSESSMENT_ARTICLE_LIMIT=3
# Parallelism (raise carefully — GitHub + LLM rate limits apply)
# ASSESSMENT_CANDIDATE_CONCURRENCY=2
# ASSESSMENT_REPO_FETCH_CONCURRENCY=3
# GITHUB_DELAY_MS=800
# ASSESSMENT_RUNS_DIR=output/assessment-runs
# DIGESTS_DIR=output/digests
# DIGEST_TOP_N=10
# DIGEST_MIN_PRIORITY=50

# Digest email (Phase 7 / explicit send only)
# DIGEST_EMAIL_TO=you@example.com
# DIGEST_EMAIL_FROM=digest@yourdomain.com
# DIGEST_EMAIL_SUBJECT_PREFIX=[tSearch Digest]
# EMAIL_PROVIDER_API_KEY=re_...
# RESEND_API_KEY=re_...

# Reviewer feedback storage (digest ranking refinement)
# FEEDBACK_DIR=data/feedback

# System oracle (src/oracle): 1 enables live LLM synthesis of answers.
# Default is extractive mode — free, offline, cited passages only.
# ORACLE_LLM=1

# Coverage sweep + autopilot (continuous discovery)
# SWEEP_LIMIT=40                # names footprint-checked per sweep invocation
# QUEUE_MIN_SCORE=0.35          # footprint score floor for the seed queue
# QUEUE_AUTORESOLVE_MIN=0.6        # sweep --resolve-top only auto-verifies at/above this score
# AUTOPILOT_SEEDS_PER_RUN=5     # LinkedIn resolves per autopilot cycle (keep small)
# AUTOPILOT_SWEEP_LIMIT=25      # sweep top-up per cycle (0 disables)
# AUTOPILOT_LIVE_LLM=1          # opt into live LLM assessment (default mock)
# AUTOPILOT_SEND=1              # opt into REAL digest email (default dry-run)
# DIGEST_PROFILE_BASE_URL=https://your-private-host/profiles  # hosted Learn-more pages (default: relative ./profiles/<digest_id>)
